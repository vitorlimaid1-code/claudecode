{
  "name": "diagramador-de-livros",
  "productName": "Casa Vertigem Hub",
  "version": "4.3.0",
  "description": "Aplicativo desktop para diagramação de livros, 100% local e offline.",
  "main": "src/main.js",
  "author": "Diagramador de Livros",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "node scripts/vendor.js && electron .",
    "test": "node scripts/vendor.js && node test/smoke.js",
    "dist:win": "node scripts/vendor.js && node scripts/build.js --win nsis,portable,zip --x64",
    "dist:linux": "node scripts/vendor.js && node scripts/build.js --linux AppImage",
    "dist:portable": "node scripts/vendor.js && node scripts/build.js --win portable,zip --x64"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "pagedjs": "0.5.0-beta.2"
  },
  "dependencies": {
    "docx": "^9.10.0",
    "hyphen": "^1.14.1",
    "jszip": "^3.10.2",
    "lcms-wasm": "^1.0.5",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "word-extractor": "^1.0.4"
  },
  "build": {
    "appId": "br.diagramador.livros",
    "productName": "Casa Vertigem Hub",
    "copyright": "Casa Vertigem Hub",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!**/node_modules/hyphen/patterns/!(pt).js",
      "!**/node_modules/hyphen/!(pt|patterns)/**",
      "!**/node_modules/mammoth/mammoth.browser*",
      "!**/node_modules/**/{test,tests,docs,example,examples}/**",
      "!**/node_modules/**/*.{md,markdown,ts,map}",
      "assets/**/*",
      "!**/node_modules/pdfjs-dist/{build,web,types,image_decoders,wasm,iccs}/**",
      "!**/node_modules/pdfjs-dist/**/*.map",
      "!**/node_modules/pdfjs-dist/legacy/build/*.min.mjs",
      "!**/node_modules/pdfjs-dist/legacy/build/pdf.sandbox*",
      "!**/node_modules/docx/dist/*.{iife.js,umd.cjs,mjs,d.ts,d.cts}",
      "!scripts/**",
      "!**/node_modules/pdfjs-dist/legacy/web/**",
      "!**/node_modules/lcms-wasm/dist/lcms.min.js*"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "livro",
        "name": "Projeto de livro",
        "description": "Projeto de livro do Casa Vertigem Hub",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "CasaVertigemHub",
      "artifactName": "Casa-Vertigem-Hub-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Casa Vertigem Hub",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "artifactName": "Casa-Vertigem-Hub-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Casa Vertigem Hub"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "compression": "maximum",
    "portable": {
      "artifactName": "Casa-Vertigem-Hub-Portatil-${version}.exe",
      "unpackDirName": "CasaVertigemHub"
    }
  }
}
